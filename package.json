{
  "name": "bancada",
  "productName": "Bancada",
  "version": "0.7.1",
  "description": "Bancada — terminais por projeto, onde parei e captura rápida (evolução do PromptPad)",
  "author": "Deckoso",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deckoso/bancada.git"
  },
  "homepage": "https://github.com/Deckoso/bancada",
  "main": "app/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prestart": "node scripts/vendor.js",
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty,better-sqlite3 && node scripts/vendor.js",
    "test": "ELECTRON_RUN_AS_NODE=1 electron --test test/unit/*.test.js",
    "test:corpus": "ELECTRON_RUN_AS_NODE=1 electron test/corpus/sessions-corpus.js",
    "predist": "node scripts/vendor.js",
    "dist": "electron-builder --mac dir --arm64",
    "install-app": "zsh scripts/install.sh",
    "update-app": "zsh scripts/update.sh",
    "share": "zsh scripts/share.sh",
    "dist:win": "node scripts/build-win.js"
  },
  "build": {
    "appId": "com.mcpp.bancada",
    "productName": "Bancada",
    "files": [
      "app/**",
      "node_modules/**",
      "package.json",
      "!node_modules/.cache/**",
      "!**/*.md",
      "!test/**",
      "app/plugin/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": false
      },
      "icon": "build/icon.icns"
    },
    "npmRebuild": false,
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "app/**",
        "node_modules/**",
        "package.json",
        "!node_modules/.cache/**",
        "!**/*.md",
        "!test/**",
        "app/plugin/**/*",
        "!node_modules/node-pty/build/**",
        "!node_modules/node-pty/prebuilds/darwin-*/**",
        "!node_modules/node-pty/prebuilds/win32-arm64/**",
        "!node_modules/node-pty/third_party/conpty/*/win10-arm64/**",
        "!node_modules/better-sqlite3/prebuilds/darwin-*",
        "!node_modules/better-sqlite3/prebuilds/linux*",
        "!node_modules/better-sqlite3/prebuilds/win32-arm64.node"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "artifactName": "Bancada-Setup-${version}-windows-x64.${ext}",
      "shortcutName": "Bancada",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "three": "0.187.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
